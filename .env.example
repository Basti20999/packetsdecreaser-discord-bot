# Discord Developer Portal > Bot > Token (keep secret)
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN
# Discord server where the commands should be registered
DISCORD_GUILD_ID=YOUR_DISCORD_SERVER_ID

# Shield API token from your PacketShield billing panel (keep secret)
SHIELD_API_KEY=YOUR_SHIELD_API_KEY

# Optional initial settings. Administrators can edit these later using /config.
# Your PROTECTED Minecraft server IPv4, NOT your bot host's IP.
SHIELD_TARGET_IP=
# Optional, comma-separated Discord role IDs (blank means admins only)
STAFF_ROLE_IDS=
# Optional Discord text channel ID
LOG_CHANNEL_ID=
# Optional custom path for persistent settings (default: settings.json)
CONFIG_PATH=
